{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "commonjs",
    "outDir": "./build",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["./src/**/*", "./package.json"],
  "exclude": [
    "node_modules",
    "./src/**/*.test.ts",
    "./src/**/*.test.js",
    "./src/test/**/*"
  ]
}
