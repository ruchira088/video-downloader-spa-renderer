{
  "name": "video-downloader-spa-renderer",
  "description": "Renders SPA pages",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "tsc && npm run setup-config",
    "compile:watch": "tsc -w",
    "clean": "rimraf build",
    "execute": "node src/main.js",
    "start": "tsx src/main.ts",
    "setup-config": "cp -r config build/config && npm run build-info",
    "build-info": "tsx scripts/build-info.ts",
    "clean-compile": "npm run clean && npm run compile",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.test.json && tsc --noEmit --project tsconfig.scripts.json",
    "lint": "oxlint src scripts",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "config": "^5.0.1",
    "express": "^5.2.1",
    "puppeteer": "^25.10.0",
    "winston": "^3.19.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/supertest": "^7.2.1",
    "cheerio": "^1.2.0",
    "jest": "^30.5.1",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "simple-git": "^3.36.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "puppeteer@25.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
